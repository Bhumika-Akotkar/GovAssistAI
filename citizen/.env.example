# Citizen PWA configuration.
# Copy to .env.local and fill in. Never commit the filled-in file.

# Where the API/WebSocket server lives. Used for the dev proxy and for the
# WS URL baked into the bundle.
VITE_SERVER_URL=http://localhost:8083

# Bumping this tells the sync page a newer catalog may exist. It should match
# the "version" field in src/data/schemes/index.json.
VITE_CATALOG_VERSION=2026-09-26

# Contact details shown on the Help page. Leave any of these blank and the
# section renders an "unavailable" state rather than a placeholder number —
# shipping a fake helpline is worse than showing none.
VITE_CONTACT_TOLLFREE=
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_CSC=
